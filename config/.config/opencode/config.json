{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "dir": "allow",
      "pwd": "allow",
      "whoami": "allow",
      "date": "allow",
      "echo *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git check-ignore *": "allow",
      "node -v": "allow",
      "npm -v": "allow",
      "python --version": "allow",
      "python3 --version": "allow"
    }
  }
}
