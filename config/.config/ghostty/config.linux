# Ghostty Configuration File
# Pfad ~/.config/ghostty/config (Linux)

# --- Theme ---
theme = "coolnight.conf"

# --- Environment ---
term = "xterm-256color"

# --- Window ---
window-padding-x = 10
window-padding-y = 10
background-opacity = 1
window-decoration = auto

# -- Surface ---
split-divider-color = "#CCCCCC"
confirm-close-surface = false

# --- Font ---
font-family = "MesloLGS Nerd Font Mono"
font-size = 16

# --- Cursor ---
shell-integration-features = no-cursor
cursor-style = bar
cursor-style-blink = true

# --- Mouse ---
cursor-click-to-move = true

# --- Custom Keybindings ---

# Clipboard
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

# Tabs
keybind = super+t=new_tab
keybind = super+1=goto_tab:1
keybind = super+2=goto_tab:2
keybind = super+3=goto_tab:3
keybind = super+4=goto_tab:4
keybind = super+5=goto_tab:5
keybind = super+6=goto_tab:6
keybind = super+7=goto_tab:7
keybind = super+8=goto_tab:8
keybind = super+9=goto_tab:9

# Wechseln zwischen Splits mit Alt + Shift + Pfeiltaste
keybind = alt+shift+up=goto_split:up
keybind = alt+shift+down=goto_split:down
keybind = alt+shift+left=goto_split:left
keybind = alt+shift+right=goto_split:right

# Wechseln zwischen Splits mit Super + Shift + Pfeiltaste
keybind = super+shift+up=goto_split:up
keybind = super+shift+down=goto_split:down
keybind = super+shift+left=goto_split:left
keybind = super+shift+right=goto_split:right

# Resizen von Splits mit Alt + Ctrl + Pfeiltaste
keybind = alt+ctrl+up=resize_split:up,30
keybind = alt+ctrl+down=resize_split:down,30
keybind = alt+ctrl+left=resize_split:left,30
keybind = alt+ctrl+right=resize_split:right,30

# Resizen von Splits mit Super + Alt + Pfeiltaste
keybind = super+alt+up=resize_split:up,30
keybind = super+alt+down=resize_split:down,30
keybind = super+alt+left=resize_split:left,30
keybind = super+alt+right=resize_split:right,30
