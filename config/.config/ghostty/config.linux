# Ghostty Configuration File
# Pfad ~/.config/ghostty/config (Linux)

# --- Theme ---
theme = "coolnight.conf"

# --- Environment ---
term = "xterm-256color"

# --- Window ---
window-padding-x = 10
window-padding-y = 10
background-opacity = 1
window-decoration = auto

# -- Surface ---
split-divider-color = "#CCCCCC"
confirm-close-surface = false

# --- Font ---
font-family = "MesloLGS Nerd Font Mono"
font-size = 16

# --- Cursor ---
shell-integration-features = no-cursor
cursor-style = bar
cursor-style-blink = true

# --- Mouse ---
cursor-click-to-move = true

# --- Custom Keybindings ---

# Clipboard (Linux Standard)
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

# Tabs (Linux Standard)
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+w=close_tab
keybind = ctrl+page_up=previous_tab
keybind = ctrl+page_down=next_tab
keybind = ctrl+1=goto_tab:1
keybind = ctrl+2=goto_tab:2
keybind = ctrl+3=goto_tab:3
keybind = ctrl+4=goto_tab:4
keybind = ctrl+5=goto_tab:5
keybind = ctrl+6=goto_tab:6
keybind = ctrl+7=goto_tab:7
keybind = ctrl+8=goto_tab:8
keybind = ctrl+9=goto_tab:9

# Splits (Linux Standard)
keybind = ctrl+shift+e=new_split:right
keybind = ctrl+shift+o=new_split:down
keybind = ctrl+alt+up=goto_split:up
keybind = ctrl+alt+down=goto_split:down
keybind = ctrl+alt+left=goto_split:left
keybind = ctrl+alt+right=goto_split:right

# Resizen von Splits (Linux Standard)
keybind = ctrl+alt+shift+up=resize_split:up,30
keybind = ctrl+alt+shift+down=resize_split:down,30
keybind = ctrl+alt+shift+left=resize_split:left,30
keybind = ctrl+alt+shift+right=resize_split:right,30
