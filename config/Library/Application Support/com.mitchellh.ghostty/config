# Ghostty Configuration File
# Pfad /Users/simon/Library/Application Support/com.mitchellh.ghostty/config

# --- Theme ---
theme = "coolnight.conf"

# --- Environment ---
term = "xterm-256color"

# --- Window ---
window-padding-x = 10
window-padding-y = 10
background-opacity = 1
window-decoration = auto
macos-titlebar-proxy-icon = hidden

# -- Surface ---
split-divider-color = "#CCCCCC"
confirm-close-surface = false

# --- Font ---
font-family = "MesloLGS Nerd Font Mono"
font-size = 16

# --- Cursor ---
# cursor-style = "bar"
# cursor-style-blink = true

# --- Mouse ---
cursor-click-to-move = true

# --- Custom Keybindings ---

# Wechseln zwischen Splits mit Command + Shift + Pfeiltaste
keybind = super+shift+up=goto_split:up
keybind = super+shift+down=goto_split:down
keybind = super+shift+left=goto_split:left
keybind = super+shift+right=goto_split:right

# Resizen von Splits mit Command + Alt + Pfeiltaste
keybind = super+alt+up=resize_split:up,30
keybind = super+alt+down=resize_split:down,30
keybind = super+alt+left=resize_split:left,30
keybind = super+alt+right=resize_split:right,30