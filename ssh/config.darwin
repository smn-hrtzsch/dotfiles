Host github.com
  HostName ssh.github.com
  Port 443
  User git

Host dgx
  HostName dgx-2.informatik.tu-freiberg.de
  User shoertzsch
  ForwardAgent yes

Host vm119
  HostName vm119.informatik.tu-freiberg.de
  User shoertzsch
  ForwardAgent yes

Host *
  AddKeysToAgent yes
  IgnoreUnknown UseKeychain
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519
